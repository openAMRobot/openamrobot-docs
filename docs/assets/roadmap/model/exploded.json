{
 "schema": 1,
 "about": "Exploded and opened-base offsets (metres, robot frame: x forward, y left, z up), build-stage membership, short labels, view settings and the guided-tour keyframes for docs/assets/roadmap/exploded.html, keyed by the component ids of model/model.js and their GLB node or part ids. offsets: Explode robot; open: Open the base. Offsets move whole parts; no geometry changes. Checked by scripts/check_roadmap.py.",
 "stages_note": "Subsystem grouping for orientation. Not an assembly instruction; the 2.0 assembly guide is in preparation.",
 "stages": [
  {
   "n": 1,
   "title": "Chassis structure",
   "text": "Steel deck, front, rear and side panels, four corner supports and the centre bracket of CAD v0.2, the base design shared with release 001.",
   "frame": "base"
  },
  {
   "n": 2,
   "title": "Drive and castors",
   "text": "Two hub motor wheels with brakes (brake side inboard) on the drive axle and four swivel castors under the deck corners. The motor driver sits on its mount on the deck.",
   "frame": "base"
  },
  {
   "n": 3,
   "title": "Power and safety",
   "text": "The battery cell-group envelope on the rear deck behind the centre bracket (provisional), drawn as eight LF105 cell boxes inside the envelope; the BMS, power distribution board, fuse and wiring go behind and beside it and are not drawn. The base E-stop (robot left) and the RESET button (robot right) sit in the front-panel holes of the release 001 buttons (P-03 rev20.0 item 24), drawn as placeholders from datasheet dimensions. The safety relay set and the charging receiver have no position in the 2.0 documentation and are listed only.",
   "frame": "base"
  },
  {
   "n": 4,
   "title": "Compute and base controller",
   "text": "The electronics bracket with the Jetson Orin NX on its J401 carrier, the NUCLEO-H723ZG base controller on its plate and the IMU board.",
   "frame": "base"
  },
  {
   "n": 5,
   "title": "Near-field sensors, LiDAR and base camera",
   "text": "Four ultrasonic sensors and two ToF cliff sensors in the panel holes with their mounts, the 2D LiDAR on its support and spacer, and the base RGB-D camera behind the front slot.",
   "frame": "base"
  },
  {
   "n": 6,
   "title": "Cover",
   "text": "The top cover and its two sloped flanges close the base.",
   "frame": "base"
  },
  {
   "n": 7,
   "title": "Lift column and adapter plate",
   "text": "The lift base plate at position bp000, the DOLD Hexalift V4 column (drawn as a primitive; supplier CAD pending) and the 10 mm adapter plate on the column top. On the rear face of the static column profile, close to its upper edge: the second E-stop. On its left side face: the three lift stop sensors on their brackets, and the flag rod with its corner bracket and steel flag hanging from the adapter plate. Placeholders until work package M-09.",
   "frame": [
    "lift_base_plate",
    "lift_column",
    "adapter_plate",
    "second_estop",
    "lift_stop_sensors",
    "flag_rod"
   ]
  },
  {
   "n": 8,
   "title": "Arm profile and arms",
   "text": "The HFS6-60120 arm profile on the adapter plate, the two OpenArm 2.0 arms on their mounts and the head camera on its bracket (lens 42 mm ahead of the shoulder, 30 degrees down). On the front of the profile, bottom up: the head light and the Getac ZX80 tablet (landscape), placeholders until work package M-09.",
   "frame": [
    "arm_profile",
    "openarm",
    "head_camera_bracket",
    "head_camera"
   ]
  }
 ],
