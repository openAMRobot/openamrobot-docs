    <child link="tof_rear"/>
  </joint>
  <gazebo reference="tof_front">
    <sensor name="tof_front_sensor" type="gpu_lidar">
      <pose relative_to="tof_front">0 0 0 0 0 0</pose>
      <topic>/tof/front</topic>
      <gz_frame_id>tof_front</gz_frame_id>
      <update_rate>50</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>3</samples>
            <resolution>1</resolution>
            <min_angle>-0.0175</min_angle>
            <max_angle>0.0175</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.2</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
      <visualize>false</visualize>
      <always_on>true</always_on>
    </sensor>
  </gazebo>
